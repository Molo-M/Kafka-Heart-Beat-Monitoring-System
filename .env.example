# Copy this file to .env and adjust if needed:
#   Copy-Item .env.example .env
# .env is ignored by Git; this example file is committed.

# --- PostgreSQL ---
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=heartbeat_pass
POSTGRES_DB=heartbeat_db
POSTGRES_HOST=localhost
# Use 5433 if PostgreSQL is also installed directly on your computer
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heartbeat-data

# --- Data generator ---
NUM_CUSTOMERS=10
SEND_INTERVAL_SECONDS=1

# --- Email alerts (Gmail) ---
# ALERT_EMAIL_PASSWORD must be a Gmail App Password, not your normal password.
# Leave these empty to turn alerts off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ALERT_EMAIL_SENDER=your.address@gmail.com
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECIPIENT=your.address@gmail.com

# --- Retries (like Airflow's "retries" and "retry_delay") ---
PIPELINE_RETRIES=3
PIPELINE_RETRY_DELAY_SECONDS=10

# --- Grafana dashboard (http://localhost:3000, user: admin) ---
# Only used the first time Grafana starts
GRAFANA_ADMIN_PASSWORD=change-me