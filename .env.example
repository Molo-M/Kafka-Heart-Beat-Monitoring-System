# Copy this file to .env and adjust if needed:
#   Copy-Item .env.example .env
# .env is ignored by Git; this example file is committed.

# --- PostgreSQL ---
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=heartbeat_pass
POSTGRES_DB=heartbeat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heartbeat-data
